{
  "name": "cc-visicore-spl-to-kql",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && apps build",
    "lint": "oxlint",
    "preview": "vite preview",
    "package": "apps package",
    "translate": "tsx scripts/translate.ts",
    "test": "vitest run",
    "test:live": "$SPL2KQL_CRIBL_CLI/.venv/bin/python tests/differential/run.py",
    "knowledge": "tsx scripts/knowledge-from-dir.ts"
  },
  "dependencies": {
    "@capra/core": "^1.15.0",
    "@capra/dx-tokens-postcss-plugin": "^0.4.0",
    "@capra/icons": "^1.10.0",
    "@capra/theme": "^1.6.0",
    "pako": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cribl/apps": "1.1.0",
    "@types/node": "^24.13.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "displayName": "SPL to KQL",
  "author": "Andrew Hendrix - CriblPacks@VisiCoreTech.com",
  "cribl": {
    "type": "app",
    "createAppScriptVersion": "1.1.0"
  },
  "tags": {
    "product": [
      "search"
    ]
  },
  "description": "Translate Splunk SPL into Cribl Search KQL with stage-by-stage notes, syntax checking against your Cribl tenant, dataset/lookup/macro validation, and one-click run or save as a Cribl saved search.",
  "license": "Apache-2.0"
}
